{
  "name": "@oras-project/oci-client",
  "version": "0.17.0",
  "description": "Node.js bindings for rust-oci-client - OCI Distribution client",
  "keywords": [
    "bindings",
    "container",
    "distribution",
    "docker",
    "napi",
    "oci",
    "registry",
    "rust"
  ],
  "homepage": "https://github.com/oras-project/rust-oci-client-node#readme",
  "bugs": {
    "url": "https://github.com/oras-project/rust-oci-client-node/issues"
  },
  "license": "Apache-2.0",
  "author": "The ORAS Authors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oras-project/rust-oci-client-node.git"
  },
  "workspaces": [
    "testing"
  ],
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "yarn sync-version && napi build --platform --release && yarn fix-const-enums",
    "build:debug": "yarn sync-version && napi build --platform && yarn fix-const-enums",
    "fix-const-enums": "node scripts/fix-const-enums.js",
    "format": "oxfmt . && cargo fmt --all",
    "lint": "oxlint .",
    "prepublishOnly": "napi prepublish -t npm --no-gh-release",
    "test": "ava",
    "version": "napi version",
    "sync-version": "node scripts/sync-version.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.4",
    "@oxc-node/core": "^0.1.3",
    "@types/node": "^20.0.0",
    "ava": "^8.0.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^5.9.2"
  },
  "napi": {
    "binaryName": "oci-client",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-musl",
      "s390x-unknown-linux-gnu",
      "powerpc64le-unknown-linux-gnu"
    ]
  },
  "ava": {
    "environmentVariables": {
      "OXC_TSCONFIG_PATH": "./__test__/tsconfig.json"
    },
    "extensions": [
      "ts"
    ],
    "nodeArguments": [
      "--import",
      "@oxc-node/core/register"
    ],
    "timeout": "2m",
    "workerThreads": false
  },
  "engines": {
    "node": ">= 22"
  },
  "packageManager": "yarn@4.12.0"
}
